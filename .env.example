# 09_web_vlm_manage 环境变量
# 复制为 .env 后填实值；缺省 settings.py 里都有兜底

# Django
DJANGO_SECRET_KEY=change-me-please-use-a-long-random-random-random
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 数据库：mysql（默认）| sqlite
#   mysql  = 外置 MySQL 服务（09 独立 database babycare_vlm，与 08 隔离）
#   sqlite = 「没有 MySQL 服务器」的本机方案：单文件数据库，零安装、零驱动
#            （Python 自带 sqlite3，不需要 mysqlclient）。
#            ⚠ 只适合单机：daphne / 音频 worker / 管理命令共用一个文件，
#              不要放在网络盘或共享目录上。
DB_ENGINE=mysql

# ---- DB_ENGINE=mysql 时生效 ----
# 装驱动：pip install mysqlclient
DB_NAME=babycare_vlm
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- DB_ENGINE=sqlite 时生效 ----
# 数据库文件路径；留空 = 09_web_vlm_manage/data/db.sqlite3（data/ 已被 .gitignore 忽略）
# 相对路径按项目根解析；也可以用绝对路径（会自动创建父目录）
# DB_SQLITE_PATH=data/db.sqlite3
# 并发写抢锁的等待上限（秒）。daphne 与 audio_worker 是两个进程，都在写库
# DB_SQLITE_TIMEOUT_SEC=20
# 注意：SQLite 模式下 settings.py 会强制 transaction_mode=IMMEDIATE + WAL，
#       原因是 `select_for_update()` 在 SQLite 上被 Django 静默忽略，
#       audio worker 的互斥锁只能靠"事务开头就拿写锁"兜住。不要绕过 settings.py 自己改。

# ---------------------------------------------------------------------------
# 运行模式：单机 / 分体（默认全部等于现状 → 不改就是单机）
# ---------------------------------------------------------------------------
# 【单机方案】服务与大模型同机 → 保持下面默认值，一切照旧。
# 【分体方案】服务线（yolo + Django + 拉流 + audio_worker）在一台机器，
#             大模型（llama-server VLM + ASR）在另一台 → 只改这 4 行：
#               BABYCARE_LLAMA_SERVER_URL         → 推理机 IP:8082
#               BABYCARE_LLAMA_EXTERNAL           → 1
#               BABYCARE_GPU_MODE                 → off
#               BABYCARE_AUDIO_DESC_SERVER_URL    → 推理机 IP:8136（文件后半段）
# 推理机侧另需：ASR 的 bind 从 127.0.0.1 改成 0.0.0.0（model/run_asr_server.bat）。
# ⚠ llama-server 的 `--api-key` **目前只能给 ASR(8136) 加** ——
#   VLM(8082) 侧的 `LlamaClient` 还没有带 `Authorization: Bearer` 的能力
#   （2026-09-16 核实：全仓库只有 AudioDescClient 支持 api_key）。
#   给 8082 加 key 会让**每条** VLM 请求 401，整条视频线哑掉。
#   → VLM 暂时只能靠"局域网可信 + 不要把端口映射到公网"；
#     要真正加 key，先给 LlamaClient 补 key 支持。
#
# VLM（llama.cpp，qwen 系列）
BABYCARE_LLAMA_SERVER_URL=http://127.0.0.1:8082

# 外部模式：1 = llama-server 在**别的机器**上 → 本进程只探活、绝不启停。
#   不开（0）：LlamaManager 照旧 spawn/kill/pidfile/health（单机现状）
#   开了（1）：不 spawn、不 kill、不 unload、不清 pidfile、不自动重启；
#              可用性由「远端 /health + 熔断器」判定。
#   分体**必须**开 —— 否则 release_vlm_if_idle() 会 POST 远端 /unload，
#   把对面正在用的服务关掉。
BABYCARE_LLAMA_EXTERNAL=0

# 显存模式：exclusive=6G 默认 YOLO/VLM 互斥；parallel=22G 并行常驻；off=不仲裁
# 分体用 off：两卡在不同机器上，没有显存竞争，状态机纯属负担。
# 建议用off，真显存不足，大模型可以单独自己定时循环跑，请求会自动排队
BABYCARE_GPU_MODE=off

# ---------------------------------------------------------------------------
# LlamaManager（Step 4：llama-server 进程管理）
# ---------------------------------------------------------------------------
# 可执行文件路径（默认走 PATH 上的 llama-server.exe；不在 PATH 上才填绝对路径）
# BABYCARE_LLAMA_SERVER_BIN=D:\AI\LLAMA\llama-server.exe

# 模型所在目录（与 gguf / mmproj 拼成完整路径）
BABYCARE_LLAMA_MODEL_DIR=D:\AI\LLAMA\MODELS

# 模型 / mmproj 文件名（两个都要填对：mmproj 是视觉编码器，漏了/mismatch 会 500）
BABYCARE_LLAMA_MODEL_NAME=qwen35-4b-Q4_K_M.gguf
BABYCARE_LLAMA_MMPROJ_NAME=mmproj-Qwen3.5-4B-F16.gguf

# 启动参数（一般不用改）
# ⚠ CTX_SIZE 三处不一致：settings.py 默认 4096 / 本文件 4096 / model/run_vlm_server.bat 8192
BABYCARE_LLAMA_CTX_SIZE=4096
BABYCARE_LLAMA_NGL=99
BABYCARE_LLAMA_CTK=q8_0
BABYCARE_LLAMA_CTV=q8_0
# 绑 127.0.0.1：只给本机访问。**不要**随手改成 0.0.0.0 —— llama-server 默认 CORS 全开
# 且没有 key，而 LlamaClient 目前不支持 api_key（加了 --api-key 会让每条请求 401），
# 等于把无鉴权的推理端点交给整个局域网。只有分体部署（推理机在另一台机器）才需要 0.0.0.0。
BABYCARE_LLAMA_HOST=127.0.0.1
BABYCARE_LLAMA_PORT=8082

# PID 文件路径（缺省 = data/llama_server.pid）
# BABYCARE_LLAMA_PID_FILE=

# parallel 模式下常驻最长小时数；到时下次 ensure_running 自动重启（防显存膨胀）
BABYCARE_LLAMA_MAX_UPTIME_HOURS=48

# 启动期 health 探测超时 + 失败重试次数
BABYCARE_LLAMA_START_TIMEOUT_SEC=60
BABYCARE_LLAMA_START_RETRIES=1

# ONVIF 摄像头（Step 2）
# 所有 ONVIF 摄像头用同一全局密码；缺省 = "" → ONVIF 摄像头 open() 直接失败
BABYCARE_ONVIF_PASSWORD=
# ONVIF wsdl 目录（onvif-zeep 0.2.12 pip 包内不带 wsdl 文件）
# 缺省时由 onvif-zeep 自动走 zeep 远程 wsdl URL（多数摄像头能工作）
# 仅在本地 ONVIF 服务失败时手动指定，例如：
#   1. 下载 wsdl：git clone --depth=1 https://github.com/FalkTannhaeuser/python-onvif-zeep.git
#   2. 拷贝：cp -r python-onvif-zeep/wsdl <some_path>
#   3. 取消下行注释：BABYCARE_ONVIF_WSDL_DIR=<some_path>
BABYCARE_ONVIF_WSDL_DIR=

# ---------------------------------------------------------------------------
# 音频检测（Step 15：音频线，独立进程 + 独立 venv）
#   设计：docs/superpowers/specs/2026-09-07-audio-detection-design.md
#   启动：$env:DJANGO_SETTINGS_MODULE="config.settings_audio"
#         ..\.venv-audio\Scripts\python.exe manage.py audio_worker
# ---------------------------------------------------------------------------
# 总开关：false → 音频线永不启动（web 侧也据此决定是否拉起 worker）
BABYCARE_AUDIO_ENABLED=false

# 音频线解释器（独立 venv）；缺省 = <项目根>/.venv-audio/Scripts/python.exe
# BABYCARE_AUDIO_PYTHON=<项目根>\.venv-audio\Scripts\python.exe

# FFmpeg / FFprobe 可执行文件（不在 PATH 上时填绝对路径）
BABYCARE_FFMPEG_BIN=ffmpeg
BABYCARE_FFPROBE_BIN=ffprobe

# 采集格式与缓冲（spec §3.2/§3.3）
BABYCARE_AUDIO_SAMPLE_RATE=16000
BABYCARE_AUDIO_READ_CHUNK_MS=200
BABYCARE_AUDIO_PRE_ROLL_SEC=5

# 断流判定与重连退避
BABYCARE_AUDIO_START_TIMEOUT_SEC=15
BABYCARE_AUDIO_STALL_SEC=5
BABYCARE_AUDIO_RECONNECT_MIN_SEC=2
BABYCARE_AUDIO_RECONNECT_MAX_SEC=30
BABYCARE_AUDIO_NO_AUDIO_RETRY_SEC=60
BABYCARE_AUDIO_ONVIF_TIMEOUT_SEC=20

# 心跳（写 vlm_audio_runtime_state）与 Camera 表轮询
BABYCARE_AUDIO_HEARTBEAT_SEC=2
BABYCARE_AUDIO_HEARTBEAT_TIMEOUT_SEC=10
BABYCARE_AUDIO_CAMERA_POLL_SEC=5

# web 侧（daphne）启停 worker 用的 PID / 日志 / 停止哨兵文件；留空 = 09_web_vlm_manage/data/
# BABYCARE_AUDIO_PID_FILE=
# BABYCARE_AUDIO_LOG_FILE=
# BABYCARE_AUDIO_STOP_FILE=

# web 侧拉起 worker 子进程用的 settings：音频 venv 无 daphne/channels，必须用这个
# （它只摘掉 daphne / channels，其余复用主 settings）；一般不用改
# BABYCARE_AUDIO_SETTINGS_MODULE=config.settings_audio

# 启动宽限期：这段时间内没有心跳不算故障（模型加载 + 等首包需 15~40s）
BABYCARE_AUDIO_WORKER_STARTUP_GRACE_SEC=45

# 优雅停止等待上限：web 写停哨兵后等 worker 自己收尾，超时才 taskkill /F /T
BABYCARE_AUDIO_STOP_GRACE_SEC=10

# ---------------------------------------------------------------------------
# 音频检测：双模型推理（Step 15 Phase 2）
# ---------------------------------------------------------------------------
# 模型资产（本地路径；YAMNet SavedModel 放到 model/yamnet/，下载方式见 README）
# BABYCARE_AUDIO_YAMNET_MODEL_DIR=<项目根>\model\yamnet
# BABYCARE_AUDIO_YAMNET_CLASS_MAP=<项目根>\model\yamnet\yamnet_class_map.csv
# BABYCARE_AUDIO_PANNS_CHECKPOINT=C:\Users\<you>\panns_data\Cnn14_mAP=0.431.pth
# BABYCARE_AUDIO_PANNS_CLASS_MAP=<项目根>\model\panns\class_labels_indices.csv

# 统一输入规格（spec §4.1）
BABYCARE_AUDIO_DECISION_WINDOW_SEC=2
BABYCARE_AUDIO_DECISION_HOP_SEC=1
BABYCARE_AUDIO_MIN_AUDIO_RATIO=0.9
# 跨帧聚合：max | mean（YAMNet 2s 窗 = 4 个 patch）
BABYCARE_AUDIO_FRAME_AGG=max

# 线程限制（P0-4：不限制时 TF 线程池空闲自旋，2 路常驻吃 ~3 核）
BABYCARE_AUDIO_TF_THREADS=1
BABYCARE_AUDIO_TORCH_THREADS=1
# 只对 PANNs 生效；YAMNet 在 Windows 上恒为 CPU（TF 无 Windows GPU 版）
BABYCARE_AUDIO_USE_GPU=false

# 判阳阈值：按模型分开（spec §4.3.1）
# ⚠️ 占位值，Phase 8 用生产 SoundDetectionLog 的近阈值窗 + 人工试听标定
BABYCARE_AUDIO_CRY_THRESHOLD_YAMNET=0.3
BABYCARE_AUDIO_CRY_THRESHOLD_PANNS=0.3
BABYCARE_AUDIO_SPEECH_THRESHOLD_YAMNET=0.3
BABYCARE_AUDIO_SPEECH_THRESHOLD_PANNS=0.3
# 近阈值落库比例（分数 ≥ 阈值 × 该值 → 落库，供事后调阈值）
BABYCARE_AUDIO_NEAR_THRESHOLD_RATIO=0.7
# 单模型降级时阈值上浮系数
BABYCARE_AUDIO_FALLBACK_THRESHOLD_SCALE=1.3
# 单侧高置信度覆盖：任一模型分数 ≥ 该值 → 也算阳性（0 < x <= 1 生效；>1 关闭）
# 2026-09-14 现场由 0.8 放宽到 0.5（and 共识下单侧 0.5 即判阳）
BABYCARE_AUDIO_HIGH_CONFIDENCE_OVERRIDE=0.5

# 共识策略：and（误报最低，默认）| or（召回最高）
BABYCARE_AUDIO_CONSENSUS=and
# 单模型故障降级：false → 严格模式（abstain 不产生新事件）
BABYCARE_AUDIO_SINGLE_MODEL_FALLBACK=false

# 每窗状态日志间隔秒；0 = 每窗都打 INFO（Phase 2 验收用）
BABYCARE_AUDIO_DETECT_LOG_SEC=5

# ---------------------------------------------------------------------------
# 音频检测：事件组装（Step 15 Phase 3）
# ---------------------------------------------------------------------------
# 事件组装开关（false → 只检测落日志，不组装事件/落盘）
BABYCARE_AUDIO_EVENTS_ENABLED=true
# 启动规则：最近 N 窗至少 K 窗共识阳性（2/3 规则）
BABYCARE_AUDIO_EVENT_START_N=3
BABYCARE_AUDIO_EVENT_START_K=2
# 单参数事件间隔（P0-7）：距末阳性超过该值则结束/新开事件
BABYCARE_AUDIO_EVENT_GAP_SEC=3
# 事件后补录（尾巴）
BABYCARE_AUDIO_POST_ROLL_SEC=3

# 自适应静音（spec §6.3）：最近 30s 能量分布的 P20 = 动态静音线
SILENCE_ADAPTIVE_WINDOW_SEC=30
SILENCE_ADAPTIVE_PERCENTILE=20
SILENCE_MIN_MS=500

# ---------------------------------------------------------------------------
# 音频描述模型（Step 15 Phase 4，spec §6.5）
# ---------------------------------------------------------------------------
# 输出方言：transcript = 纯转写（Qwen3-ASR 等，只回人声文字）
#           json       = 结构化描述（MOSS-Audio-4B / Qwen2.5-Omni-7B 等，回 JSON）
# 非法值按 transcript 处理；两种方言最终产出的 description_json 结构一致。
# transcript 下描述原文照放，判定字段（has_cry / has_adult_speech /
# background_sounds）全部为 null = 未判定 —— 判断由声学侧两个小模型负责。
BABYCARE_AUDIO_DESC_PROVIDER=transcript

# 服务地址：URL 为空 → 描述服务不启动（录音播放不受影响）
#   单机方案：llama-server 跑在本进程同一台机器上
BABYCARE_AUDIO_DESC_SERVER_URL=http://127.0.0.1:8136
#   分体方案：推理机在另一台机器，只换这个地址即可（局域网，不走公网）
# ！暴露到局域网前必须给推理机的 llama-server 加 `--api-key`，并在这里填同一个值
# BABYCARE_AUDIO_DESC_SERVER_URL=http://192.168.1.50:8136
BABYCARE_AUDIO_DESC_MODEL=Qwen3-ASR-1.7B
BABYCARE_AUDIO_DESC_API_KEY=
# 单次请求 read 超时（模型跑多久）：同机 30s 足够（转写模型单段 0.2~0.7s）；
# 分体 + 大模型要放长
BABYCARE_AUDIO_DESC_TIMEOUT_SEC=30
# 单次请求 connect 超时（服务在不在），与 read 超时分开。
# 给得小：服务停掉后连接可能挂 SYN 等超时（不是立刻 RST），共用 read 超时
# 会让"服务不可用"要 read×(max_retries+1) ≈ 92s 才被发现，熔断也就迟迟不开。
BABYCARE_AUDIO_DESC_CONNECT_TIMEOUT_SEC=3.0
# 单次请求内重试次数（timeout/网络错误；4xx/解析失败不重试）
BABYCARE_AUDIO_DESC_MAX_RETRIES=2

# 描述服务
BABYCARE_AUDIO_DESCRIBE_ENABLED=true
BABYCARE_AUDIO_DESCRIBE_POLL_SEC=5
# 单段输出上限：转写长语音建议 1024（60s 人声 ≈ 300~500 token），
# 结构化描述模型沿用 512 即可
BABYCARE_AUDIO_DESCRIBE_MAX_TOKENS=1024
# 分段级重试：失败隔 60s 再试。
# **这个配额只管"内容类"失败**（解析错 / 校验错 / 切片缺失）；服务不可达（timeout /
# 网络错 / 5xx）**不消耗配额**，事件会一直留在 describing 等服务恢复后自动追上。
# 耗尽了才判事件 failed（录音与分段都保留，不删）。
BABYCARE_AUDIO_DESCRIBE_RETRY_BACKOFF_SEC=60
BABYCARE_AUDIO_DESCRIBE_MAX_SEGMENT_RETRIES=8

# ---------------------------------------------------------------------------
# 熔断器 + 队列时效（分体部署；见 docs/superpowers/specs/2026-09-16-split-deploy-plan.md）
# ---------------------------------------------------------------------------
# 推理机不是 7×24 → 两条 llama 线（VLM :8082 / ASR :8136）会长时间不可达。
# 熔断器让调用方别再白试，请求留在各自的 DB 队列里攒着，恢复后回放。
# **关掉它 = 回到旧行为**（VLM 丢窗口 / ASR 8 分钟熬成永久 failed）。
#
# 总开关：0 = 完全旁路（永远放行、不计数）
BABYCARE_LLM_BREAKER_ENABLED=true
# 连续"服务侧"失败多少次 → 熔断打开。
# **只数服务侧**（connect error / timeout / 5xx）；解析错、校验错、4xx 是内容问题，
# 不算服务不可用 —— 计进去会把 bug 藏起来，还白停一条可用的服务。
#
# 通用默认 3；**两条线默认值不同，因为代价不对称**：
#   ASR（无 live 流量，唯一消费者就是 DescribeService）→「攒着」零成本 → 1
#   VLM（有 live 窗口竞争）→ 一次读超时就把 live 窗口压进队列最多 60s → 3
# ASR 给 1 的前提：connect 超时已独立压到 3s（见
# BABYCARE_AUDIO_DESC_CONNECT_TIMEOUT_SEC），误判一次的代价只有一个 3s 请求
# + 最多 60s 排队，而排队的工作会被回放，**不丢数据**。
BABYCARE_LLM_FAIL_THRESHOLD=3
# 各线独立覆盖（不写则 VLM 回落上面这个通用默认）
BABYCARE_LLM_FAIL_THRESHOLD_ASR=1
BABYCARE_LLM_FAIL_THRESHOLD_VLM=3
# 熔断打开后多久放一条探测（探活 = 真实业务请求，没有独立 health 轮询线程）
BABYCARE_LLM_BREAKER_COOLDOWN_SEC=60
# 半开态给调用方用的**短超时**。探测必须便宜，否则它自己就把链路堵死：
#   ASR 正常 30s × (2+1) = 最坏 90s
#   VLM timeout_sec_first=60s 且 LlamaClient._chat_lock 全局串行
# 半开探测同时**不重试**（代码里写死 max_retries=0）。
BABYCARE_LLM_PROBE_TIMEOUT_SEC=5
# 队列时效（两条线共用）：超过该秒数仍未处理的项标 expired，不再处理。
# 0 = 不收割（当前默认：先给 0，上线按真实积压调）。
# 为什么要它：队列改成 newest-first 后，老的永远排不到，需要一个显式出口把
# 控制页的"待处理"数字收干净。
BABYCARE_LLM_QUEUE_MAX_AGE_SEC=0
# 回放时，事件距现在超过该秒数 → **只落库、不发通知**（0 = 迟到多久都发）。
# 与上面那条正交：「不判」和「判了但不打扰你」是两件事。
BABYCARE_LLM_REPLAY_NOTIFY_MAX_DELAY_SEC=0

# 分段（spec §6.4）：目标 10~60s 优先静音点切；无静音点超 90s 按 60s 强制切；<1s 丢弃
BABYCARE_AUDIO_SEGMENT_MIN_SEC=10
BABYCARE_AUDIO_SEGMENT_MAX_SEC=60
BABYCARE_AUDIO_SEGMENT_HARD_MAX_SEC=90
BABYCARE_AUDIO_SEGMENT_DISCARD_SEC=1

# YOLO 模型（Step 3）；缺省指向 <项目根>/model/best.pt（需自备，不入库）
# BABYCARE_BABY_MODEL=<项目根>\model\best.pt

# ---------------------------------------------------------------------------
# Home Assistant（Step 9 通知）
# ---------------------------------------------------------------------------
# HA base URL（去掉尾部 /；默认 09 项目跑在和 HA 同机或 LAN）
HA_URL=http://127.0.0.1:8123

# HA 长期访问令牌（HA web UI → 用户头像 → Long-Lived Access Tokens → Create）
HA_TOKEN=

# 通知目标不在 .env 里配置：到网页「通知目标」页新建（等价 HA 服务/实体 ID）
#   kind=mobile_app → target_id = notify.mobile_app_xxx
#   kind=speaker    → target_id = text.xiaomi_xxx
# 建好后到「VLM 检查项」详情页勾选，并选条件 always / audio_rule